# macOS
.DS_Store

# Env files (keep .env.example tracked)
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node / Next (not currently used; kept for safety)
node_modules/
.next/
out/

# Swift Package Manager build output
app-mac/.build/
app-mac/.swiftpm/
app-mac/Package.resolved
.build/
.swiftpm/
DerivedData/

# IDE
.idea/
.vscode/

# Indexer-generated data — personal content; rebuilds from source.
# Whole tree, so subdirectories (backups, scratch runs) can't leak either.
indexer/data/

# Eval data mined from the real corpus — contains real names, dates and facts.
# The runner and the fabricated fixtures are tracked; these two are not.
evals/golden_queries.yaml
evals/baselines.json
evals/control_queries.yaml

# Logs / tmp
*.log
tmp/
.tmp/
